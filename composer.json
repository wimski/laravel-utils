{
    "name": "wimski/laravel-utils",
    "description": "Miscellaneous utilities for Laravel",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.3"
    },
    "autoload": {
        "psr-4": {
            "Wimski\\LaravelUtils\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
      "sort-packages": true
    }
}
